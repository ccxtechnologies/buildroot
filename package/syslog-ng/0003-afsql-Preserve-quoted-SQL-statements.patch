From: HofiOne <hofione@users.noreply.github.com>
Subject: [PATCH] afsql: Preserve quoted SQL statements

Upstream: https://github.com/syslog-ng/syslog-ng/pull/5774
--- a/modules/afsql/afsql.c
+++ b/modules/afsql/afsql.c
@@ -226,7 +226,7 @@ afsql_dd_run_query(AFSqlDestDriver *self, const gchar *query, gboolean silent, d
   msg_debug("Running SQL query",
             evt_tag_str("query", escaped_query));
 
-  db_res = dbi_conn_query(self->dbi_ctx, escaped_query);
+  db_res = dbi_conn_query(self->dbi_ctx, query);
   if (!db_res)
     {
       const gchar *dbi_error;
@@ -247,8 +247,7 @@ afsql_dd_run_query(AFSqlDestDriver *self, const gchar *query, gboolean silent, d
                         evt_tag_str("user", self->user),
                         evt_tag_str("database", self->database),
                         evt_tag_str("error", dbi_error),
-                        evt_tag_str("query", query),
-                        evt_tag_str("escaped_query", escaped_query));
+                        evt_tag_str("query", escaped_query));
             }
         }
       g_free(escaped_query);
